---
import { SITE } from '@/config/site';
import SocialLinks from '@/components/ui/SocialLinks.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <p class="copyright">
      © {year}
      {SITE.copyrightHolder}. All rights reserved.
      <a href="/privacy">Privacy</a>
    </p>
    <SocialLinks size="sm" />
  </div>
</footer>

<style>
  /*
   * No margin-top: #main already ends with its own padding, and stacking a
   * second gap on top of it left the footer stranded far below the content.
   */
  .site-footer {
    border-top: 1px solid var(--color-border);
    padding: var(--space-8) var(--container-padding);
    background-color: var(--color-bg);
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    max-width: var(--container-max);
    margin-inline: auto;
  }

  .copyright {
    color: var(--color-text-muted);
    font-size: var(--fs-sm);
    margin: 0;
  }

  /*
   * Separated by a middot rather than a gap: the link sits inside the
   * copyright sentence, and without a divider the two run together as one
   * phrase at small sizes.
   */
  .copyright a {
    color: inherit;
  }

  .copyright a::before {
    content: '·';
    margin-inline: var(--space-2);
  }

  .copyright a:hover,
  .copyright a:focus-visible {
    color: var(--color-text);
  }

  @media (max-width: 640px) {
    .footer-inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
