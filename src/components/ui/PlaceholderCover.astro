---
/*
 * Stand-in artwork for a project with no publishable screenshot. Drawn from
 * theme tokens rather than shipped as an image, so it follows light and dark
 * instead of sitting as a bright slab on a dark page (or the reverse).
 */
interface Props {
  /** Match the aspect of the real covers it stands in for. */
  ratio?: string;
  class?: string;
}

const { ratio = '16 / 10', class: className = '' } = Astro.props;
---

<div class:list={['placeholder', className]} style={`aspect-ratio: ${ratio};`} aria-hidden="true">
  <svg viewBox="0 0 160 100" preserveAspectRatio="xMidYMid meet" focusable="false">
    <circle class="halo" cx="80" cy="48" r="34"></circle>
    <g class="device">
      <rect x="66" y="20" width="28" height="60" rx="4.5"></rect>
      <rect class="bar" x="70" y="25" width="20" height="7" rx="1.6"></rect>
      <rect class="line" x="70" y="37" width="20" height="3" rx="1.5"></rect>
      <rect class="line" x="70" y="44" width="14" height="3" rx="1.5"></rect>
      <rect class="line" x="70" y="51" width="18" height="3" rx="1.5"></rect>
      <rect class="bar" x="70" y="62" width="20" height="6" rx="1.6"></rect>
    </g>
  </svg>
</div>

<style>
  .placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    background-color: var(--color-surface-2);
  }

  svg {
    width: 100%;
    height: 100%;
  }

  .halo {
    fill: var(--color-accent);
    opacity: 0.12;
  }

  .device rect {
    fill: var(--color-surface);
    stroke: var(--color-border-strong);
    stroke-width: 0.8;
  }

  .device .bar {
    fill: var(--color-accent);
    stroke: none;
  }

  .device .line {
    fill: var(--color-border-strong);
    stroke: none;
    opacity: 0.7;
  }
</style>
