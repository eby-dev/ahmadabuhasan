---
interface Props {
  as?: 'article' | 'div' | 'li' | 'section';
  interactive?: boolean;
  padding?: 'sm' | 'md' | 'lg' | 'none';
  /**
   * Lay the card out as a full-height flex column. Needed when a child must be
   * pinned to the card foot (`margin-top: auto`) so it aligns across a row of
   * cards — a consumer cannot do this from its own scoped styles, because the
   * element rendered here carries only this component's scope id.
   */
  stack?: boolean;
  class?: string;
}

const {
  as: Tag = 'article',
  interactive = false,
  padding = 'md',
  stack = false,
  class: className = '',
} = Astro.props;

const classes = [
  'card',
  `padding-${padding}`,
  interactive && 'interactive',
  stack && 'stack',
  className,
]
  .filter(Boolean)
  .join(' ');
---

<Tag class={classes}>
  <slot />
</Tag>

<style>
  .card {
    display: block;
    /* Lifted off the page ground so cards read as surfaces in both themes. */
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .stack {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .padding-none {
    padding: 0;
  }
  .padding-sm {
    padding: var(--space-4);
  }
  .padding-md {
    padding: var(--space-6);
  }
  .padding-lg {
    padding: var(--space-8);
  }

  .interactive {
    transition:
      border-color var(--motion-fast),
      box-shadow var(--motion-fast),
      transform var(--motion-fast);
  }

  .interactive:hover {
    border-color: var(--color-border-strong);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }
</style>
