---
import { Image, getImage } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import PageLayout from '@/layouts/PageLayout.astro';
import Container from '@/components/layout/Container.astro';
import Badge from '@/components/ui/Badge.astro';
import Button from '@/components/ui/Button.astro';
import PlaceholderCover from '@/components/ui/PlaceholderCover.astro';
import CreativeWorkJsonLd from '@/components/seo/CreativeWorkJsonLd.astro';
import BreadcrumbJsonLd from '@/components/seo/BreadcrumbJsonLd.astro';

export async function getStaticPaths() {
  const entries = await getCollection('projects');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

type Props = { entry: CollectionEntry<'projects'> };
const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

const description = data.description;
const statusVariant =
  data.status === 'shipped' ? 'success' : data.status === 'in-progress' ? 'accent' : 'muted';
const statusLabel = data.status === 'in-progress' ? 'In progress' : data.status;

const ogPreview = await getImage({
  src: data.cover,
  width: 1200,
  format: 'webp',
});
---

<PageLayout title={data.title} description={description} image={ogPreview.src} ogType="article">
  <CreativeWorkJsonLd entry={entry} imageUrl={ogPreview.src} />
  <BreadcrumbJsonLd
    items={[
      { name: 'Home', href: '/' },
      { name: 'Projects', href: '/projects/' },
      { name: data.title, href: `/projects/${entry.id}/` },
    ]}
  />
  <Container>
    <nav aria-label="Breadcrumb" class="breadcrumb">
      <a href="/projects">← All projects</a>
    </nav>

    <header class="head">
      <div class="head-body">
        <p class="eyebrow">{data.sector} · {data.category}</p>
        <h1>{data.title}</h1>
        <p class="lede">{data.description}</p>

        <div class="head-actions">
          {
            data.links.playStore && (
              <Button href={data.links.playStore} variant="primary" size="md" external>
                <svg
                  aria-hidden="true"
                  width="15"
                  height="15"
                  viewBox="0 0 16 16"
                  fill="currentColor"
                >
                  <path d="M14.222 9.374c1.037-.61 1.037-2.137 0-2.748L11.528 5.04 8.32 8l3.207 2.96 2.694-1.586Zm-3.595 2.116L7.583 8.68 1.03 14.73c.201 1.029 1.36 1.61 2.303 1.055l7.294-4.294ZM1 13.396V2.603L6.846 8 1 13.396ZM1.03 1.27 7.583 7.32l3.044-2.81L3.333.215C2.39-.341 1.231.24 1.03 1.27Z" />
                </svg>
                Play Store
              </Button>
            )
          }
          {
            data.links.website && (
              <Button href={data.links.website} variant="secondary" size="md" external>
                Website
              </Button>
            )
          }
          {
            data.links.github && (
              <Button href={data.links.github} variant="secondary" size="md" external>
                GitHub
              </Button>
            )
          }
        </div>
      </div>

      <div class="cover-wrap">
        <div class="glow" aria-hidden="true"></div>
        <div class="cover">
          {
            data.placeholderCover ? (
              <PlaceholderCover />
            ) : (
              <Image
                src={data.cover}
                alt={`${data.title} — app screens`}
                widths={[540, 1080]}
                sizes="(max-width: 768px) 100vw, 540px"
                loading="eager"
              />
            )
          }
        </div>
      </div>
    </header>

    <dl class="facts">
      {
        data.client && (
          <div class="fact">
            <dt>Client</dt>
            <dd>{data.client}</dd>
          </div>
        )
      }
      {
        data.contribution && (
          <div class="fact">
            <dt>Role</dt>
            <dd>{data.contribution}</dd>
          </div>
        )
      }
      <div class="fact">
        <dt>Year</dt>
        <dd>{data.publishedAt.getUTCFullYear()}</dd>
      </div>
      {
        data.press ? (
          <div class="fact">
            <dt>Press</dt>
            <dd class="fact-accent">
              {data.press.url ? (
                <a href={data.press.url} target="_blank" rel="noopener noreferrer">
                  {data.press.outlet}
                </a>
              ) : (
                data.press.outlet
              )}
            </dd>
          </div>
        ) : (
          <div class="fact">
            <dt>Status</dt>
            <dd>
              <Badge variant={statusVariant}>{statusLabel}</Badge>
            </dd>
          </div>
        )
      }
    </dl>

    <div class="case">
      <div class="case-body">
        {
          data.problem && (
            <section class="case-section">
              <h2>The problem</h2>
              <p>{data.problem}</p>
            </section>
          )
        }
        {
          data.approach && (
            <section class="case-section">
              <h2>The approach</h2>
              <p>{data.approach}</p>
            </section>
          )
        }
        {
          data.longDescription && (
            <section class="case-section prose">
              <p>{data.longDescription}</p>
            </section>
          )
        }
        <section class="prose">
          <Content />
        </section>
      </div>

      {
        data.tech.length > 0 && (
          <aside class="tech-panel" aria-labelledby="tech-heading">
            <h2 id="tech-heading" class="section-h">
              Built with
            </h2>
            <ul class="tech">
              {data.tech.map((t) => (
                <li>
                  <Badge variant="neutral">{t}</Badge>
                </li>
              ))}
            </ul>
          </aside>
        )
      }
    </div>
  </Container>
</PageLayout>

<style>
  .breadcrumb {
    margin-bottom: var(--space-4);
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
  }

  .breadcrumb a {
    color: var(--color-text-muted);
  }

  .breadcrumb a:hover {
    color: var(--color-accent);
  }

  /*
   * Mirrors the homepage hero, but with a more even split: the cover here is a
   * landscape mockup rather than a single upright device, so it needs the width.
   */
  .head {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
    gap: var(--space-8);
    align-items: center;
    padding: var(--space-10);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .head-body {
    display: flex;
    flex-direction: column;
  }

  .eyebrow {
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0 0 var(--space-3);
  }

  .head h1 {
    margin: 0 0 var(--space-3);
    font-size: var(--fs-3xl);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-tight);
    line-height: var(--lh-tight);
  }

  .lede {
    color: var(--color-text-muted);
    font-size: var(--fs-base);
    line-height: var(--lh-normal);
    margin: 0 0 var(--space-6);
    max-width: 46ch;
  }

  .head-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  /*
   * The cover art is a landscape mockup of several screens, so it is shown
   * whole at its own ratio. An earlier version cropped it into a 9:16 phone
   * frame, which threw most of the image away and upscaled what was left.
   */
  .cover-wrap {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .glow {
    position: absolute;
    inset: -10%;
    background: radial-gradient(
      circle at 50% 50%,
      color-mix(in srgb, var(--color-accent) 14%, transparent),
      transparent 70%
    );
  }

  .cover {
    position: relative;
    width: 100%;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background-color: var(--color-surface-2);
    overflow: hidden;
  }

  .cover :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* --- Fact bar --- */
  .facts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    margin: var(--space-4) 0 0;
    background-color: var(--color-border);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .fact {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4) var(--space-5);
    background-color: var(--color-surface);
  }

  .fact dt {
    font-size: var(--fs-xs);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  .fact dd {
    margin: 0;
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    color: var(--color-text);
  }

  .fact-accent,
  .fact-accent a {
    color: var(--color-accent);
  }

  /* --- Case body --- */
  .case {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--space-8);
    align-items: start;
    margin-top: var(--space-12);
  }

  .case-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .case-section h2 {
    font-size: var(--fs-lg);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-snug);
    margin: 0 0 var(--space-3);
  }

  .case-section p {
    margin: 0;
    color: var(--color-text-muted);
    line-height: var(--lh-normal);
  }

  .tech-panel {
    padding: var(--space-6);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .section-h {
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
    margin: 0 0 var(--space-4);
  }

  .tech {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .prose {
    color: var(--color-text-muted);
    line-height: var(--lh-normal);
  }

  .prose p {
    margin-block: 0 var(--space-4);
  }

  .prose p:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 900px) {
    .head {
      padding: var(--space-8);
    }
  }

  /*
   * Stacked: the cover moves above the text rather than being hidden. Unlike
   * the homepage hero's decorative device, this is the project's own artwork
   * and is worth the vertical space on a phone.
   */
  @media (max-width: 768px) {
    .head,
    .case {
      grid-template-columns: minmax(0, 1fr);
    }

    .head {
      padding: var(--space-6);
    }

    .cover-wrap {
      order: -1;
      margin-bottom: var(--space-2);
    }

    .facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .case {
      gap: var(--space-6);
      margin-top: var(--space-8);
    }
  }

  @media (max-width: 640px) {
    .head h1 {
      font-size: var(--fs-2xl);
    }

    .head-actions {
      width: 100%;
    }
  }
</style>
