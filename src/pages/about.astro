---
import PageLayout from '@/layouts/PageLayout.astro';
import AboutSection from '@/components/sections/AboutSection.astro';

const title = 'About';
const description =
  'Mobile Developer shipping production Android (Kotlin/Java) and Flutter apps for government, healthcare, education, and real estate sectors.';
---

<PageLayout title={title} description={description} emitPersonSchema ogType="profile">
  <AboutSection variant="full" titleLevel={1} />
</PageLayout>
