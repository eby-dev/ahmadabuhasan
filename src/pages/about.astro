---
import PageLayout from '@/layouts/PageLayout.astro';
import AboutSection from '@/components/sections/AboutSection.astro';

const title = 'About';
const description =
  'Mobile Developer with 4 years of experience building Android (Kotlin/Java) and Flutter apps across government, healthcare, education, and real estate.';
---

<PageLayout title={title} description={description} emitPersonSchema ogType="profile">
  <AboutSection variant="full" titleLevel={1} />
</PageLayout>
